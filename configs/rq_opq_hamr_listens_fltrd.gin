import modules.rq_tokenizer
import data.processed

train.tokenizer_type=%modules.rq_tokenizer.RqTokenizerType.OPQ
train.iterations=20000
train.learning_rate=0.0001
train.weight_decay=0.0001
train.batch_size=1024
train.vae_input_dim=128
train.vae_embed_dim=32
train.vae_codebook_size=128
train.vae_n_layers=3
train.vae_n_cat_feats=0
train.opq_subspaces=2
train.opq_codes=128
train.commitment_weight=0.25
train.kmeans_init_samples=80000
train.kmeans_refresh_every=10000
train.save_model_every=10000
train.eval_every=10000
train.log_every=100
train.save_dir_root="out/rq_opq_hamr/listens_fltrd/"
train.pretrained_path=None
train.dataset_folder="dataset/yambda"
train.dataset=%data.processed.RecDataset.YAMBDA
train.dataset_split="500m"
train.dataset_interaction="listens_fltrd"
train.force_dataset_process=False
train.hamr_weight=0.1
train.hamr_R=2
train.hamr_m_full=0.5
train.hamr_m_partial=0.3
train.hamr_lambda_full=1.0
train.hamr_lambda_partial=0.5
